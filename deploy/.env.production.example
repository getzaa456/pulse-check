# Public domain. Point its DNS A/AAAA record to the VM first.
APP_DOMAIN=status.example.com

# Database
POSTGRES_DB=pulsecheck
POSTGRES_USER=pulsecheck
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
DISCORD_WEBHOOK_URL=
