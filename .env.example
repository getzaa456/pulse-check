# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# PostgreSQL / TimescaleDB
DATABASE_URL=postgres://pulsecheck:pulsecheck@localhost:5432/pulsecheck?sslmode=disable

# Redis / BullMQ
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret

# Email notification
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=

# Optional Discord notification
DISCORD_WEBHOOK_URL=
